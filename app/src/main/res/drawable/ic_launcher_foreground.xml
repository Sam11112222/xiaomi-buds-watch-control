<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">

    <!-- left half of the ring: solid = noise cancelling -->
    <path android:strokeWidth="5" android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M54,26 A28,28 0 0,0 54,82">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="54" android:startY="26" android:endX="54" android:endY="82">
                <item android:offset="0" android:color="#FF6FD6FF" />
                <item android:offset="1" android:color="#FF4F7BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- right half: broken arcs = sound passing through (transparency) -->
    <path android:strokeColor="#E6FFFFFF" android:strokeWidth="5" android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M63.58,27.69 A28,28 0 0,1 75.45,36 M80.31,44.42 A28,28 0 0,1 80.31,63.58 M75.45,72 A28,28 0 0,1 63.58,80.31" />

    <!-- two stem earbuds -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M45,39a7,7 0 1,0 0.01,0z M42,49h6v17a3,3 0 0,1 -6,0z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M63,39a7,7 0 1,0 0.01,0z M60,49h6v17a3,3 0 0,1 -6,0z" />
    <!-- ear tips -->
    <path android:fillColor="#FF9CC9FF" android:pathData="M50.5,43.5a3,3 0 1,0 0.01,0z" />
    <path android:fillColor="#FF9CC9FF" android:pathData="M57.5,43.5a3,3 0 1,0 0.01,0z" />
</vector>
