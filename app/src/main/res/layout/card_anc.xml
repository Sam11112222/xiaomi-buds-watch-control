<?xml version="1.0" encoding="utf-8"?>
<!-- 217 x 88 dp: the size OPPO uses for its own cards on the ColorOS Watch card screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/card_w"
    android:layout_height="@dimen/card_h"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/card_header"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_card_buds" />

        <TextView
            android:id="@+id/card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="耳机"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/card_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="点按切换"
            android:textColor="#FF9AA0A8"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_off"
            style="@style/CardButton"
            android:layout_marginEnd="3dp">
            <ImageView android:id="@+id/ic_off" style="@style/CardButtonIcon" android:src="@drawable/ic_mode_off" />
            <TextView android:id="@+id/lb_off" style="@style/CardButtonText" android:text="关闭" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_anc"
            style="@style/CardButton"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp">
            <ImageView android:id="@+id/ic_anc" style="@style/CardButtonIcon" android:src="@drawable/ic_mode_anc" />
            <TextView android:id="@+id/lb_anc" style="@style/CardButtonText" android:text="降噪" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_trans"
            style="@style/CardButton"
            android:layout_marginStart="3dp">
            <ImageView android:id="@+id/ic_trans" style="@style/CardButtonIcon" android:src="@drawable/ic_mode_trans" />
            <TextView android:id="@+id/lb_trans" style="@style/CardButtonText" android:text="通透" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
